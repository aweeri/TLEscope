/* Windows VERSIONINFO resource template for TLEscope.
 * Rendered by scripts/gen_versioninfo.sh at build time; the @PLACEHOLDERS@
 * are replaced with the version derived from git (see scripts/version.sh).
 * Compiled with windres and linked into TLEscope.exe so that
 * Properties -> Details shows real version metadata. */

1 VERSIONINFO
FILEVERSION     @FILEVERSION_COMMA@
PRODUCTVERSION  @PRODUCTVERSION_COMMA@
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TLEscope"
            VALUE "FileDescription", "TLEscope - real-time satellite tracking and orbit simulation tool"
            VALUE "FileVersion", "@FILEVERSION_STR@"
            VALUE "InternalName", "TLEscope"
            VALUE "OriginalFilename", "TLEscope.exe"
            VALUE "ProductName", "TLEscope"
            VALUE "ProductVersion", "@PRODUCTVERSION_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END