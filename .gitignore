### Girlypop ignore ###
# Directories With Compiled Files
bin/
build/
dist/
plans/
.vscode

# Dynamic Files With Dynamic Data or PIIs
/data.tle
/settings.json

# Compoile Commands CLANGD
/compile_commands.json

$null
dev_thoughts.md

# csv exports
*.csv
build_win/

# build-time generated application icon (rasterized from src/ui/logo_raster.h
# by scripts/gen_icon.cpp); never commit a binary icon
/build/logo.ico
/build/gen_icon
/build/gen_icon.exe

# raylib is a git submodule (lib/raylib); ignore its build artifacts
lib/raylib/src/*.o
lib/raylib/src/libraylib.a
lib/raylib/src/*.dll
lib/raylib/src/*.dll.a
lib/raylib/src/*.so*
lib/raylib/src/*.dylib*

# for people who accidentally run with tlescope main as workspace instead of under dist

imgui.ini
data.json
data_selections.json